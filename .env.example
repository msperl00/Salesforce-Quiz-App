QUIZ_DATABASE_PATH=./data/quiz.sqlite

# Local sin cuentas: local. Para probar las cuentas: accounts.
NUXT_AUTH_MODE=local
# Genera una clave aleatoria de al menos 32 caracteres antes de activar cuentas.
NUXT_SESSION_PASSWORD=

# Turso: las mismas variables se configuran en Vercel (sin comillas).
NUXT_TURSO_DATABASE_URL=
NUXT_TURSO_AUTH_TOKEN=

# Solo para npm run user:create. No subir ni configurar en Vercel.
QUIZ_ADMIN_EMAIL=
QUIZ_ADMIN_PASSWORD=
